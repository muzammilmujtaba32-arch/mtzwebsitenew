// Cloudflare Workers config: serves the static website in site/ (docs/ and tools/ are not published).
{
  "name": "mumtaztilezone",
  "compatibility_date": "2026-10-01",
  // Keep the free address live: https://mumtaztilezone.mumtaztilezone.workers.dev
  "workers_dev": true,
  "assets": {
    "directory": "./site",
    "not_found_handling": "404-page"
  },
  // mumtaztilezone.com must be a zone in the same Cloudflare account for these custom domains to attach.
  "routes": [
    { "pattern": "mumtaztilezone.com", "custom_domain": true },
    { "pattern": "www.mumtaztilezone.com", "custom_domain": true }
  ]
}
